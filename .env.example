# 複製為 .env 後填入。.env 不可提交到版本控制。

# ── Claude：對話模型 ──
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# 思考深度：low / medium / high / xhigh / max。閒聊用 low 回應較快。
CLAUDE_EFFORT=low

# ── MiniMax：語音合成 ──
MINIMAX_API_KEY=
# 已複製好的魏嘉賢聲音 voice_id
MINIMAX_VOICE_ID=
# 游淑貞的聲音 voice_id
MINIMAX_VOICE_ID_YU_SHU_CHEN=
# 張峻的聲音 voice_id
MINIMAX_VOICE_ID_CHANG_CHUN=
# 國際版預設 https://api.minimax.io/v1；中國大陸版帳號改用 https://api.minimaxi.com/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_TTS_MODEL=speech-2.8-hd
# 語速：0.5（慢）～2（快），1 為預設。例如本人講話較快可設 1.15
MINIMAX_TTS_SPEED=1

# 每日提問次數上限（控制 Claude 費用），台灣時間午夜歸零；設為 0 代表不限制。
# 每呼叫一次 Claude 算一次，多人對談問全體時三位各算一次。
DAILY_LIMIT_PER_IP=60
DAILY_LIMIT_TOTAL=300

PORT=3000
# 監聽位址；部署到伺服器（前面有 Apache）時設成 127.0.0.1
# HOST=127.0.0.1
# 手機等其他裝置要用麥克風必須走 HTTPS；預設另開這個埠，使用自動產生的自簽憑證（存在 certs/）
HTTPS=true
HTTPS_PORT=3443

# ── 本機語音辨識（stt/stt_server.py，mlx-whisper）──
# 預設隨 npm start 自動啟動；需要 uv、ffmpeg 與 Apple 晶片
STT_AUTOSTART=true
STT_URL=http://127.0.0.1:3010
# STT_MODEL=mlx-community/whisper-large-v3-turbo

# 開發用：顯示「朗讀測試」開關，輸入文字直接以角色聲音朗讀，不經 LLM。私人試用前改為 false。
TTS_TEST_MODE=false

# 多人對談頁（/panel.html）：以虛構測試角色代替尚未授權的參選人，只供測試
DEMO_CHARACTERS=false
